{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sovra:plugins:v1",
  "title": "Sovra plugin package or catalog, version 1",
  "description": "Editor validation for version 1. Run check_catalog before publishing: UTF-8 byte budgets, duplicate names and identities, URL policy, version component ranges, and download integrity are enforced by Sovra's parser.",
  "oneOf": [
    { "$ref": "#/$defs/package" },
    { "$ref": "#/$defs/catalog" }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "shortText": {
      "$ref": "#/$defs/text",
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
    },
    "title": {
      "$ref": "#/$defs/shortText",
      "maxLength": 120,
      "description": "At most 120 UTF-8 bytes; check_catalog enforces the byte limit."
    },
    "description": {
      "$ref": "#/$defs/shortText",
      "maxLength": 1000,
      "description": "At most 1000 UTF-8 bytes; check_catalog enforces the byte limit."
    },
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+(-[a-z0-9]+)*){2,}$",
      "description": "Stable reverse-domain name with at least three segments. Each segment is at most 64 ASCII characters."
    },
    "version": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "Immutable major.minor.patch; each component is at most 4294967295."
    },
    "address": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "format": "uri",
      "description": "Direct HTTPS address without credentials, query, fragment or surrounding spaces. HTTP loopback is allowed for development. check_catalog enforces this policy."
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "title", "description", "instructions"],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": { "$ref": "#/$defs/text", "maxLength": 128 },
        "description": { "$ref": "#/$defs/text", "maxLength": 1024 },
        "instructions": {
          "$ref": "#/$defs/text",
          "maxLength": 65536,
          "description": "Procedure guidance, at most 65536 UTF-8 bytes. Does not grant tools or permissions."
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "address"],
      "properties": {
        "name": { "$ref": "#/$defs/title" },
        "address": { "$ref": "#/$defs/address" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "api_version", "id", "version", "title", "description"],
      "properties": {
        "schema_version": { "type": "integer", "const": 1 },
        "api_version": { "type": "integer", "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "title": { "$ref": "#/$defs/title" },
        "description": { "$ref": "#/$defs/description" },
        "skills": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/skill" }
        },
        "services": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/service" }
        }
      },
      "anyOf": [
        { "required": ["skills"], "properties": { "skills": { "minItems": 1 } } },
        { "required": ["services"], "properties": { "services": { "minItems": 1 } } }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "version", "api_version", "package_url", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/title" },
        "description": { "$ref": "#/$defs/description" },
        "version": { "$ref": "#/$defs/version" },
        "api_version": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "package_url": { "$ref": "#/$defs/address" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "plugins"],
      "properties": {
        "schema_version": { "type": "integer", "const": 1 },
        "plugins": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/entry" }
        },
        "next": { "anyOf": [{ "$ref": "#/$defs/address" }, { "type": "null" }] },
        "previous": { "anyOf": [{ "$ref": "#/$defs/address" }, { "type": "null" }] }
      }
    }
  }
}
