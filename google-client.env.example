# Sovra's Google "Desktop app" OAuth client, baked into local builds so
# Connect Google needs no setup. Copy to google-client.env (gitignored) and fill
# in from Google Cloud project `sovrasrx` → Google Auth Platform → Clients.
# Build-time environment variables of the same name win over this file.
SOVRA_GOOGLE_CLIENT_ID=
SOVRA_GOOGLE_CLIENT_SECRET=
